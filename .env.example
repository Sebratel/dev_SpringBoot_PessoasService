# Copie para .env (que NUNCA vai para o Git) e preencha. Padrão: SCREAMING_SNAKE_CASE com prefixo de domínio.

# --- Servidor ---
APP_ENV=local            # local | development | staging | production
SERVER_PORT=8106

# --- Banco e integrações ---
ERP_DB_URL=
ERP_DB_USER=
ERP_DB_PASS=

# --- Observabilidade ---
LOG_LEVEL=INFO
ELASTIC_APM_SERVER_URL=  # vazio = APM desligado (obrigatório no CI)
